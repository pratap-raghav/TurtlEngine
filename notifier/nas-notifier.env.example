# TurtlEngine Telegram boot-notifier configuration.
#
# Copy this file to /etc/nas-notifier.env and fill in the real values.
# setup-notifier.sh does that copy for you and chmod 600's the result.
# The real /etc/nas-notifier.env is gitignored and must never be committed.

# --- How to get a bot token -------------------------------------------------
# 1. In Telegram, message @BotFather and send /newbot.
# 2. Follow the prompts (name + username) and copy the token it gives back.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithTheRealOne

# --- How to get your chat id ------------------------------------------------
# 1. Send any message to your new bot once (so it is allowed to reply to you).
# 2. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser.
# 3. Find "chat":{"id":<number>} in the JSON and copy that number here.
TELEGRAM_CHAT_ID=123456789

# --- Optional ---------------------------------------------------------------
# SSH user shown in the paste-ready command. Defaults to the invoking user
# (the account that ran setup-notifier.sh) if left blank.
SSH_USER=

# tmux session name to attach to. Defaults to "main" if left blank.
TMUX_SESSION=main
